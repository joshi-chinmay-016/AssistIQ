# AssistIQ Environment Variables Configuration (Backend)
# Place your active configuration in backend/.env
# DO NOT COMMIT backend/.env OR ANY SECRET KEYS TO VERSION CONTROL.

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative alias:
# ASSISTIQ_LLM_API_KEY=your_gemini_api_key_here

# Model identifier (default: gemini-2.5-flash)
ASSISTIQ_LLM_MODEL=gemini-2.5-flash

# Provider: 'gemini' for live API, 'mock' for local offline testing
ASSISTIQ_LLM_PROVIDER=gemini

# Generation parameters
ASSISTIQ_LLM_TEMPERATURE=0.1
ASSISTIQ_LLM_MAX_TOKENS=512

# Retrieval Top-K evidence count for generation context
ASSISTIQ_TOP_K=5

# Evaluation limit (number of golden set queries to evaluate in Phase 3)
ASSISTIQ_EVAL_LIMIT=30

# API Server Configuration (Phase 5)
ASSISTIQ_API_HOST=0.0.0.0
ASSISTIQ_API_PORT=8000
ASSISTIQ_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
